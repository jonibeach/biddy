#!/usr/bin/env bash
# One entry point for the whole cell. Every step runs in the right venv:
# the Studio venv (physicalai, LeRobot, OpenVINO) or anomaly/.venv (Anomalib).
#
#   ./biddy setup                 create anomaly/.venv; check Studio, devices, cameras
#   ./biddy devices               OpenVINO devices (CPU GPU NPU)
#   ./biddy status                Studio datasets, trainers, jobs, models
#   ./biddy check [dataset]       sanity-check recorded demos (default: latest)
#   ./biddy poses record|show|goto <name>
#   ./biddy roi <image>|--camera  pick the inspection crop box
#   ./biddy anomaly [dataset]     extract crops from demos -> train -> INT8 -> benchmark
#   ./biddy cloud-trainer         deploy Studio's trainer on a Modal GPU and register it in Studio
#   ./biddy train-policy [args]   train in Studio and wait (e.g. --trainer modal --policy smolvla)
#   ./biddy bench                 time policy and anomaly models on CPU/GPU/NPU
#   ./biddy mock [args]           whole loop with mock arm/cameras/policy
#   ./biddy run [args]            the real cell (e.g. --cycles 10 --show)
#   ./biddy debug-server          always-on debug page at http://localhost:8765
#   ./biddy prepare [dataset]     check + anomaly + bench: everything after recording
#
# Extra arguments go to the underlying tool; each has --help.
set -euo pipefail
SELF="$(readlink -f "$0")"  # absolute, so recursive calls work after the cd
cd "$(dirname "$SELF")"

STUDIO_PY="${STUDIO_PY:-$HOME/physical-ai-studio/application/backend/.venv/bin/python}"
ANOMALY_PY="anomaly/.venv/bin/python"
UV="${UV:-$(command -v uv || echo "$HOME/.local/bin/uv")}"
# Settings the cell reads; override with BIDDY_CONFIG=other.yaml (relative to the repo)
CONFIG="${BIDDY_CONFIG:-station.yaml}"

die() { echo "biddy: $*" >&2; exit 1; }
need_studio_py() { [ -x "$STUDIO_PY" ] || die "Studio venv not found at $STUDIO_PY (set STUDIO_PY)"; }
need_anomaly_py() { [ -x "$ANOMALY_PY" ] || die "anomaly venv missing: run ./biddy setup"; }
# Combined commands chain several tools with different options, so they take
# only the dataset; per-step options go to check / extract / train-anomaly.
dataset_only() {
  [ $# -le 1 ] && [[ "${1:-}" != -* ]] || die "'$cmd' takes only a dataset name; pass options to check, extract or train-anomaly"
}
cfg() { "$STUDIO_PY" -c "import yaml,sys; c=yaml.safe_load(open('$CONFIG')); print(eval(sys.argv[1], {}, {'c': c}))" "$1"; }

cmd="${1:-help}"; shift || true
case "$cmd" in
  setup)
    need_studio_py
    "$UV" sync --project anomaly
    echo "--- devices";  "$STUDIO_PY" -m cell.intel
    echo "--- studio";   "$STUDIO_PY" -m cell.studio --config "$CONFIG"
    ;;
  devices) need_studio_py; "$STUDIO_PY" -m cell.intel ;;
  status)  need_studio_py; "$STUDIO_PY" -m cell.train_policy --config "$CONFIG" --list ;;
  check)   need_studio_py; "$STUDIO_PY" scripts/check_dataset.py --config "$CONFIG" "$@" ;;
  poses)   need_studio_py; "$STUDIO_PY" -m cell.poses --config "$CONFIG" "$@" ;;
  roi)     need_studio_py; "$STUDIO_PY" anomaly/roi.py --config "$CONFIG" "$@" ;;
  extract) need_studio_py; "$STUDIO_PY" anomaly/extract.py --config "$CONFIG" "$@" ;;
  train-anomaly)
    need_anomaly_py
    # One model per camera view (inspection.views), from data/anomaly/<view>.
    for view in $(cfg "' '.join(c['inspection']['views'])"); do
      if [ ! -d "data/anomaly/$view/good" ]; then echo "skip $view: no data/anomaly/$view/good"; continue; fi
      out="$(cfg "c['inspection']['views']['$view']['model']")"; out="${out%-int8}"
      echo "=== $view -> $out"
      "$ANOMALY_PY" anomaly/train.py --data "data/anomaly/$view" --out "$out" --int8 "$@"
    done
    ;;
  anomaly)
    need_studio_py; need_anomaly_py; dataset_only "$@"
    "$STUDIO_PY" anomaly/extract.py --config "$CONFIG" "$@"
    "$SELF" train-anomaly
    "$SELF" bench --policy
    ;;
  cloud-trainer)
    command -v modal >/dev/null || die "Modal CLI missing: uv tool install modal --with python-dotenv && modal token new"
    need_studio_py; "$STUDIO_PY" scripts/setup_modal_trainer.py "$@" ;;
  train-policy) need_studio_py; "$STUDIO_PY" -m cell.train_policy --config "$CONFIG" "$@" ;;
  bench)   need_studio_py; "$STUDIO_PY" -m cell.bench --config "$CONFIG" "$@" ;;
  mock)
    need_studio_py
    "$STUDIO_PY" -m cell.run --config "$CONFIG" --mock "$@"
    ;;
  run)     need_studio_py; "$STUDIO_PY" -m cell.run --config "$CONFIG" "$@" ;;
  debug-server) need_studio_py; "$STUDIO_PY" scripts/debug_server.py "$@" ;;
  prepare)
    dataset_only "$@"
    "$SELF" check "$@"
    "$SELF" anomaly "$@"
    ;;
  help|-h|--help) awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$SELF" ;;
  *) die "unknown command '$cmd' (./biddy help)" ;;
esac
